<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="B0358DE2-77D9-41B7-AC6F-6D2CBA681944"
           Name="PxeVice"
           Language="1033"
           Codepage="1252"
           Version="0.1.0"
           Manufacturer="Daniel L. Baldissera"
           UpgradeCode="BAC16563-96B0-438B-879E-8C73285C0DDC">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="PxeVice PXE reset tool"
             Comments="Clears leftover PXE data so a machine can PXE boot again" />

    <MajorUpgrade Schedule="afterInstallFinalize" DowngradeErrorMessage="A newer version of PxeVice is already installed." />

    <!-- A running PxeVice holds PxeVice.exe open, so an upgrade or uninstall would stall on files in use.
         Close it first, as SYSTEM, which also ends a copy running as administrator, before the files are installed.
         The old version is removed after the installation, because Windows Installer allows no action
         between InstallInitialize and RemoveExistingProducts (error 2613). -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <CustomAction Id="ClosePxeVice" Directory="SystemFolder" ExeCommand="taskkill.exe /F /IM PxeVice.exe" Execute="deferred" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="ClosePxeVice" After="InstallInitialize" />
    </InstallExecuteSequence>

    <Media Id="1" Cabinet="pxevice.cab" EmbedCab="yes" />

    <Property Id="NETFX4RELEASE">
      <RegistrySearch Id="NetFx4Release" Root="HKLM" Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full" Name="Release" Type="raw" Win64="yes" />
    </Property>
    <Condition Message="PxeVice needs .NET Framework 4.5 or later.">Installed OR NETFX4RELEASE</Condition>

    <Icon Id="PxeVice.ico" SourceFile="PxeVice.ico" />
    <Property Id="ARPPRODUCTICON" Value="PxeVice.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="PxeVice">

          <Component Id="PxeViceExe" Guid="A1E755FC-2AFD-4F72-8543-6912377F9DAC" Win64="yes">
            <File Id="PxeViceExe" Name="PxeVice.exe" Source="PxeVice.exe" KeyPath="yes" DefaultVersion="0.1.0.0">
              <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuFolder"
                        Name="PxeVice"
                        Description="Clears leftover PXE data so a machine can PXE boot again"
                        WorkingDirectory="INSTALLDIR" />
            </File>
          </Component>

          <Component Id="Registration" Guid="F551162F-5BE4-49C1-B1C7-D3FA71382C42" Win64="yes">
            <RegistryValue Root="HKLM" Key="Software\PxeVice" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\PxeVice.exe" Type="string" Value="[INSTALLDIR]PxeVice.exe" />
          </Component>

        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="SystemFolder" />
    </Directory>

    <Feature Id="Main" Title="PxeVice" Level="1">
      <ComponentRef Id="PxeViceExe" />
      <ComponentRef Id="Registration" />
    </Feature>
  </Product>
</Wix>
